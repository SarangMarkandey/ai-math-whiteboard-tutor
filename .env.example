# Server-only Free Plan key. Do not enable billing.
GROQ_API_KEY=your_groq_api_key_here
GROQ_LESSON_MODEL=openai/gpt-oss-20b
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah

# Required for production live features. Use the EXISTING Neon Free project's pooled URL.
# Keep sslmode=verify-full. Never prefix these names with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=verify-full
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEMO_SESSION_SECRET=replace_with_at_least_32_random_characters
